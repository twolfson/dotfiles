                    {
                        "_comment": "Forked from https://ke-complex-modifications.pqrs.org/#touch_bar_lock",
                        "_comment2": "2024-07-05: Switched from `workflows` (Quick Actions) to `spaces` since `workflows` always shows a \"Configure with Extension Settings\" button (can't configure to hide), after upgrading to Sonoma -- whereas `spaces` shows \"Desktop\" which does nothing",
                        "description": "shift+fn toggles touchbar mode between 'workflows' and 'fullControlStrip'",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "fn",
                                    "modifiers": { "mandatory": ["shift"] }
                                },
                                "to": [{ "shell_command": "if [[ $(defaults read com.apple.touchbar.agent PresentationModeGlobal) == 'spaces' ]]; then defaults write com.apple.touchbar.agent PresentationModeGlobal 'fullControlStrip'; else defaults write com.apple.touchbar.agent PresentationModeGlobal 'spaces'; fi && pkill ControlStrip" }],
